# ===== 平常 PingChang · 后端环境变量（附录 A）=====
# 开发：cp .env.example .env 即可跑通；生产：deploy/.env.production（权限 600，绝不入库）

# --- 基础 ---
NODE_ENV=development
PORT=3000

# --- 数据库（与 deploy/docker-compose.dev.yml 一致）---
MONGO_URI=mongodb://pingchang:pingchang_dev@localhost:27017/pingchang?authSource=admin

# --- 种子数据（npm run seed）---
# 官方账号「平常信使」的登录密码；不填则每次 seed 随机生成并打印在日志里
SEED_OFFICIAL_PASSWORD=

# --- 鉴权（生产必须换成 ≥32 随机字节，如 openssl rand -hex 32）---
JWT_SECRET=dev-only-secret-change-me-in-production
JWT_EXPIRES=2h
REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# --- CORS（生产填正式域名，逗号分隔多个）---
CORS_ORIGIN=http://localhost:5173

# --- 内容安全：阿里云文本审核增强版（T4.1；生产必填，开发不填则仅本地敏感词快筛）---
ALI_GREEN_AK_ID=
ALI_GREEN_AK_SECRET=
ALI_GREEN_REGION=cn-shanghai
# 业务场景 service code，须与控制台开通的服务一致
ALI_GREEN_SERVICE=comment_detection_pro
# endpoint 覆盖（默认 https://green-cip.{region}.aliyuncs.com；VPC 内网可换内网地址）
ALI_GREEN_ENDPOINT=
ALI_GREEN_TIMEOUT_MS=3000
# 审核服务异常时是否放行（契约默认 true：放行 + 记日志）
MODERATION_FAIL_OPEN=true

# --- AI 灵感（T4.2；密钥仅服务端）---
# dashscope（阿里云百炼·通义千问，默认）| anthropic
AI_PROVIDER=dashscope
DASHSCOPE_API_KEY=
# DashScope OpenAI 兼容端点（默认官方公网；测试/国际站可覆盖）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ANTHROPIC_API_KEY=
# 模型覆盖（空则用 provider 默认：dashscope=qwen-plus / anthropic=claude-opus-4-8）
AI_MODEL=
# 每用户每日限频 / 超时降级（毫秒）
AI_DAILY_LIMIT=20
AI_TIMEOUT_MS=8000
