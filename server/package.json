{
  "name": "pingchang-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "平常 PingChang Web 版后端 API（契约：design/.../docs/API-WEB-v1.0.md）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "job:match": "node src/scripts/runJob.js dailyMatch",
    "job:memory": "node src/scripts/runJob.js memoryToday",
    "job:inactivity": "node src/scripts/runJob.js inactivityCheck",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.5",
    "node-cron": "^4.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0"
  },
  "devDependencies": {
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0"
  }
}
