# 生产环境变量模板（M8）。用法：复制为 .env.production 并填好，权限 600，绝不入库。
#   cp .env.production.example .env.production && chmod 600 .env.production

NODE_ENV=production
PORT=3000

# ── MongoDB（compose 内网；MONGO_URI 的主机名必须是服务名 mongo）──────────────
# 用户名随意，密码请改成强随机串（两处的密码必须一致）
MONGO_INITDB_ROOT_USERNAME=pingchang
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_到强密码
MONGO_URI=mongodb://pingchang:CHANGE_ME_到强密码@mongo:27017/pingchang?authSource=admin

# ── 鉴权（JWT_SECRET 必须 ≥32 位随机；生成：openssl rand -hex 32）─────────────
JWT_SECRET=CHANGE_ME_用_openssl_rand_hex_32_生成
JWT_EXPIRES=2h
REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# ── 访问来源白名单：先填公网 IP，绑域名后改成 https://你的域名 ────────────────
CORS_ORIGIN=http://你的公网IP

# ── 可选：内容安全（不填则仅本地敏感词快筛，够测试用）────────────────────────
# ALI_GREEN_AK_ID=
# ALI_GREEN_AK_SECRET=
# ALI_GREEN_REGION=cn-shanghai
MODERATION_FAIL_OPEN=true

# ── 可选：AI 灵感（不填则续写/润色降级提示，不影响写信主流程）──────────────────
# AI_PROVIDER=dashscope
# DASHSCOPE_API_KEY=
AI_DAILY_LIMIT=20
AI_TIMEOUT_MS=8000
